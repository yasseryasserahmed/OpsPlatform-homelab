# Copy this file to terraform.tfvars and replace the example values before
# running terraform plan.
aws_region         = "eu-north-1"
vpc_cidr           = "10.20.0.0/16"
public_subnet_cidr = "10.20.1.0/24"

# Replace with a real Ubuntu AMI ID available in eu-north-1.
ami_id        = "ami-0123456789abcdef0"
instance_type = "m7i-flex.large"

# Replace with the name of an existing EC2 key pair in eu-north-1.
key_name = "replace-with-existing-key-pair"

# Documentation-only example address. Replace with your current public IPv4
# address in /32 notation; do not use this example value for deployment.
allowed_ssh_cidr = "198.51.100.10/32"

# Limit direct NodePort testing to your public IP; replace with your own /32.
allowed_ingress_cidr = "198.51.100.10/32"
